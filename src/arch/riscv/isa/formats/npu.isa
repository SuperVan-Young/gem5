def template NpuLaunchDeclare {{
    class %(class_name)s : public Store
    {
      private:
        %(reg_idx_arr_decl)s;

      public:
        %(class_name)s(ExtMachInst machInst);
        Fault execute(ExecContext *, trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *, trace::InstRecord *) const override;
        Fault completeAcc(PacketPtr, ExecContext *,
                          trace::InstRecord *) const override;
        std::string generateDisassembly(
            Addr pc, const loader::SymbolTable *symtab) const override;
    };
}};

def template NpuLaunchConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst)
        : Store("%(mnemonic)s", machInst, MemWriteOp)
    {
        %(set_reg_idx_arr)s;
    }
}};

def template NpuLaunchExecute {{
    Fault
    %(class_name)s::execute(
        ExecContext *xc, trace::InstRecord *traceData) const
    {
        uint64_t payload[8] = {};
        const int stageRegs[8] = {
            MISCREG_NPU_CMD0, MISCREG_NPU_CMD1, MISCREG_NPU_CMD2,
            MISCREG_NPU_CMD3, MISCREG_NPU_CMD4, MISCREG_NPU_CMD5,
            MISCREG_NPU_CMD6, MISCREG_NPU_CMD7};
        for (size_t i = 0; i < 8; ++i) {
            payload[i] = xc->readMiscReg(stageRegs[i]);
        }
        return xc->tcBase()->getCpuPtr()->initiateNpuLaunch(
            reinterpret_cast<const uint8_t *>(payload), sizeof(payload));
    }

    Fault
    %(class_name)s::initiateAcc(
        ExecContext *xc, trace::InstRecord *traceData) const
    {
        uint64_t payload[8] = {};
        const int stageRegs[8] = {
            MISCREG_NPU_CMD0, MISCREG_NPU_CMD1, MISCREG_NPU_CMD2,
            MISCREG_NPU_CMD3, MISCREG_NPU_CMD4, MISCREG_NPU_CMD5,
            MISCREG_NPU_CMD6, MISCREG_NPU_CMD7};
        for (size_t i = 0; i < 8; ++i) {
            payload[i] = xc->readMiscReg(stageRegs[i]);
        }
        return xc->tcBase()->getCpuPtr()->initiateNpuLaunch(
            reinterpret_cast<const uint8_t *>(payload), sizeof(payload));
    }

    Fault
    %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        return NoFault;
    }

    std::string
    %(class_name)s::generateDisassembly(
        Addr pc, const loader::SymbolTable *symtab) const
    {
        std::stringstream ss;
        ss << mnemonic;
        return ss.str();
    }
}};

def format NpuLaunchOp(*flags) {{
    iop = InstObjParams(name, Name, 'Store', '', ['IsStore'] + makeList(flags))
    header_output = NpuLaunchDeclare.subst(iop)
    decoder_output = NpuLaunchConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = NpuLaunchExecute.subst(iop)
}};

def format NpuStageOp(code, *opt_flags) {{
    iop = InstObjParams(name, Name, 'RegOp', code, opt_flags)
    header_output = BasicDeclare.subst(iop)
    decoder_output = BasicConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = BasicExecute.subst(iop)
}};
